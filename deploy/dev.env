# Deploy contract — circusliving-dev on the personal-infra swarm manager.
#
# This file is the source of truth for what is deployed to dev. Source it
# (or pass to `scripts/deploy.sh dev`) and the swarm stack
# `circusliving-dev` will be applied with these values.
#
# Anything missing here is missing in production-dev. Do not paper over
# defaults inside `deploy/docker-compose.swarm.yml`.

# Logical environment name. Used as both the stack-name suffix and the
# ${STACK_ENV} interpolation in docker-compose.swarm.yml (Traefik router
# and service names become `circusliving-dev`).
STACK_ENV=dev

# Hostname Traefik will route + request a Let's Encrypt cert for. Must
# resolve to the swarm manager EIP. Managed by personal-infra CDK's
# ReverseProxyStack (A record in the circusliving.com apex zone).
STACK_HOSTNAME=dev.circusliving.com

# ECR image tag. The `dev` floating tag is published by
# .github/workflows/build-and-push.yml on every push to the `dev` branch;
# the immutable `dev-<short-sha>` tag is also published and is what we
# pin here for reproducibility. Override at deploy time to redeploy a
# specific sha.
IMAGE_TAG=dev

# Docker secret name that holds the DatoCMS API token. Created once on
# the manager with:
#   docker secret create dato_api_token - <<< "$NUXT_DATO_API_TOKEN"
# nuxt.config.ts reads NUXT_DATO_API_TOKEN_FILE (mounted at
# /run/secrets/${DATO_SECRET_NAME}) at boot.
DATO_SECRET_NAME=dato_api_token

# Public canonical URL — used by Nuxt for canonical link tags and OG
# metadata. Dev points back at itself (avoids accidental SEO leaks of
# dev content under the prod canonical).
NUXT_PUBLIC_CANONICAL_BASE_URL=https://dev.circusliving.com

# GA4 measurement id. Empty in dev — set per env if you want analytics
# on the dev hostname (we usually don't).
NUXT_PUBLIC_GA_TAG_ID=

# Replicas. One is enough for dev on a single-node swarm.
REPLICAS=1

# Copy to .env.deploy.dev / .env.deploy.stg / .env.deploy.prod on the swarm
# manager, then `set -a; source .env.deploy.<env>; set +a` before running
# `docker stack deploy ...`. Never commit a real value.

# Which env this stack represents — drives traefik router/service names so
# dev, stg, prod do not collide on the same swarm.
STACK_ENV=dev

# Public hostname routed to this stack by Traefik (also drives the
# Let's Encrypt cert request).
STACK_HOSTNAME=dev.circusliving.com

# Tag of the image to deploy. Set to a specific sha tag in CI; `latest` is
# only safe for the dev stack.
IMAGE_TAG=latest

# Optional overrides:
# IMAGE=231549978717.dkr.ecr.us-east-1.amazonaws.com/circusliving/amp
# REPLICAS=1
# NUXT_PUBLIC_CANONICAL_BASE_URL=https://www.circusliving.com
# NUXT_PUBLIC_GA_TAG_ID=
# DATO_SECRET_NAME=dato_api_token

# Required external docker secret (create out-of-band, once per env if you
# want per-env tokens):
#   docker secret create dato_api_token - <<< "$NUXT_DATO_API_TOKEN"
